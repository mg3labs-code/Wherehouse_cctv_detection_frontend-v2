# Baked into the production Vite build (Railway frontend → Railway FastAPI).
VITE_API_ORIGIN=https://wherehousecctvdetection-production.up.railway.app

# Left blank deliberately — this file is committed to git, so the real
# secret must NOT live here. Set VITE_API_KEY as an actual environment
# variable in Railway's Variables tab for the frontend service before
# building; Vite gives an already-set process environment variable
# precedence over the same key in this file, so the real value wins at
# build time without ever being committed.
VITE_API_KEY=
