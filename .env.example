# Copy to .env.local for local overrides (gitignored).
# Production uses .env.production.
VITE_API_ORIGIN=http://127.0.0.1:8001

# Must match the backend's HYPERVIS_API_KEY exactly (see the backend's
# .env.example). Put your real value in .env.local (gitignored) for local
# dev — never in this file or in .env.production, which are committed.
VITE_API_KEY=
